---
import Landing from '../layouts/Landing.astro';
import InstallLockup from '../components/InstallLockup.astro';

const command = 'npx @manhquy/flow-skill@latest';
const tutorial = '/docs/tutorials/install-and-first-run/';
const stages = [
	{ name: 'Idea', file: 'flow/00-idea.md' },
	{ name: 'Research', file: 'flow/01-research.md' },
	{ name: 'Scope', file: 'flow/02-scope.md' },
	{ name: 'PRD', file: 'flow/03-prd.md' },
	{ name: 'ADR', file: 'flow/04-adr.md' },
	{ name: 'Contract', file: 'flow/05-contract.md' },
];
const afterInstall = [
	'Skill files land in the agent home.',
	'Type /flow (Codex: $flow).',
	'doctor can print READY.',
	'/flow next on an empty idea file refuses with line numbers.',
];
const willNotPass = [
	'An empty file.',
	'A leftover [FILL] still in the file.',
	'“Tests pass” offered as done.',
];
---

<Landing lang="en">
	<title slot="head">flow — hollow work does not advance</title>
	<meta
		slot="head"
		name="description"
		content="A gated harness around the coding agent you already use. npx @manhquy/flow-skill@latest. Killing a weak idea at a gate is valid. Not an agent."
	/>
	<main>
		<section class="sheet" aria-label="Install and outcomes">
			<div class="hero">
				<p class="display" translate="no">flow</p>
				<h1 class="headline">Hollow work does not advance.</h1>
				<p class="lede">
					A gated harness around the coding agent you already use. Flow owns the gates and
					the receipts, never the runtime. Killing a weak idea at a gate is a valid outcome.
				</p>
				<p class="verdict">The gate opens only when both agree.</p>
			</div>
			<InstallLockup
				command={command}
				copyLabel="Copy"
				copiedLabel="Copied"
				selectLabel="Selected — press Ctrl+C"
				secondaryHref={tutorial}
				secondaryLabel="Install and first run"
			/>
			<div class="galleys">
				<article class="galley" aria-labelledby="after-install-title">
					<h2 id="after-install-title">After install</h2>
					<svg class="pass-mark" role="img" aria-label="PASS"><use href="#tick"></use></svg>
					<p>
						The skill is on disk. <code translate="no">/flow</code> or
						<code translate="no">$flow</code> exists.
						<code translate="no">doctor</code> can print <code translate="no">READY</code>.
						<code translate="no">/flow next</code> on an empty idea file refuses with line
						numbers.
					</p>
					<ul class="proofs">{afterInstall.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="galley" aria-labelledby="will-not-pass-title">
					<h2 id="will-not-pass-title">What will not pass</h2>
					<p>
						Empty, leftover <code translate="no">[FILL]</code>, or “tests pass” offered as done.
						<span class="kill-line">A weak idea is killed at the gate.</span>
					</p>
					<ul class="proofs">{willNotPass.map((item) => <li>{item}</li>)}</ul>
				</article>
			</div>
			<ol class="pipeline" aria-label="Idea through Contract">
				{stages.map((stage) => <li class="pipe">{stage.name}</li>)}
			</ol>
		</section>

		<section class="band run" aria-labelledby="run-title">
			<h2 class="band-title" id="run-title">Six gates before you build</h2>
			<p class="band-lede">
				Each stage writes a real file in your repo. <code translate="no">/flow next</code> will
				not unlock the next one until the runner and the skill both agree. Those files exist
				after you walk the gates, not after install.
			</p>
			<ol class="run-list">
				{
					stages.map((stage) => (
						<li>
							<span class="run-stage">{stage.name}</span>
							<code class="run-file" translate="no">
								{stage.file}
							</code>
						</li>
					))
				}
			</ol>
			<p class="band-foot">
				Then <code translate="no">/flow card</code>. Done means proof in the world: a deployed
				URL, a CLI that installs and runs, a public API, or a real skill run.
			</p>
		</section>

		<section class="band stand" aria-labelledby="stand-title">
			<div class="stand-copy">
				<h2 class="stand-title" id="stand-title">Not an AI coding agent. A harness around one.</h2>
				<p>
					flow does not write your code. The agent still writes; the harness decides whether
					that work may advance.
				</p>
			</div>
			<div class="stand-actions">
				<a class="action primary" href={tutorial}>Install and first run</a>
				<a class="action" href="/docs/">Read the docs</a>
			</div>
		</section>
	</main>
</Landing>
