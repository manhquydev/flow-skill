---
import Landing from '../../layouts/Landing.astro';
import InstallLockup from '../../components/InstallLockup.astro';

const command = 'npx @manhquy/flow-skill@next';
const tutorial = '/vi/docs/tutorials/install-and-first-run/';
const stages = [
	{ name: 'Idea', file: 'flow/00-idea.md' },
	{ name: 'Research', file: 'flow/01-research.md' },
	{ name: 'Scope', file: 'flow/02-scope.md' },
	{ name: 'PRD', file: 'flow/03-prd.md' },
	{ name: 'ADR', file: 'flow/04-adr.md' },
	{ name: 'Contract', file: 'flow/05-contract.md' },
];
const afterInstall = [
	'Skill nằm trong agent home.',
	'Gõ /flow (Codex: $flow).',
	'doctor in READY.',
	'/flow next trên thư mục trống thì cổng chặn.',
];
const willNotPass = [
	'File trống.',
	'[FILL] còn trong file.',
	'“tests pass” thế cho bằng chứng done.',
];
---

<Landing lang="vi">
	<title slot="head">flow: cổng chặn việc rỗng</title>
	<meta
		slot="head"
		name="description"
		content="Agent vẫn viết code, còn cổng mở hay đóng thì flow quyết. Phải cả flow.sh lẫn skill thì cổng mới mở. Bị chặn ở cổng thì dừng luôn, chứ không phải fail. npx @manhquy/flow-skill@next"
	/>
	<main>
		<section class="sheet" aria-label="Cài rồi cổng">
			<div class="hero">
				<p class="display" translate="no">flow</p>
				<h1 class="headline">Việc rỗng thì cổng không mở.</h1>
				<p class="lede">
					Agent vẫn viết code, còn cổng mở hay đóng thì flow quyết. Flow sở hữu cổng và biên
					nhận, không bao giờ sở hữu runtime. Bị chặn ở cổng thì dừng luôn, chứ không phải fail.
				</p>
				<p class="verdict">Cổng chỉ mở khi cả hai cùng đồng ý.</p>
			</div>
			<InstallLockup
				command={command}
				copyLabel="Sao chép"
				copiedLabel="Đã sao chép"
				selectLabel="Đã chọn, nhấn Ctrl+C"
				secondaryHref={tutorial}
				secondaryLabel="Cách cài"
			/>
			<div class="galleys">
				<article class="galley" aria-labelledby="after-install-title">
					<h2 id="after-install-title">Sau khi cài</h2>
					<svg class="pass-mark" aria-hidden="true"><use href="#tick"></use></svg>
					<p>
						Skill nằm trong agent home. Gõ <code translate="no">/flow</code> (Codex:
						<code translate="no">$flow</code>). <code translate="no">doctor</code> in
						<code translate="no">READY</code>. <code translate="no">/flow next</code> trên
						thư mục trống thì cổng chặn. <code translate="no">flow.sh</code> vẫn là lớp 0/1.
					</p>
					<ul class="proofs">{afterInstall.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="galley" aria-labelledby="will-not-pass-title">
					<h2 id="will-not-pass-title">Cổng không cho qua</h2>
					<p>
						File trống, <code translate="no">[FILL]</code> còn sót, hoặc “tests pass” thế cho
						bằng chứng done.
						<span class="kill-line">Ý tưởng yếu thì dừng ngay tại cổng.</span>
					</p>
					<ul class="proofs">{willNotPass.map((item) => <li>{item}</li>)}</ul>
				</article>
			</div>
			<ol class="pipeline" aria-label="Sáu cổng trước khi build">
				{stages.map((stage) => <li class="pipe">{stage.name}</li>)}
			</ol>
		</section>

		<section class="band run" aria-labelledby="run-title">
			<h2 class="band-title" id="run-title">Sáu cổng rồi mới tới card build đầu</h2>
			<p class="band-lede">
				Mỗi cổng để lại một file thật trong repo. File hiện tại chưa qua cả hai bên thì
				<code translate="no">/flow next</code> không mở cổng sau. Những file đó có sau khi đi
				cổng, không phải sau <code translate="no">npx</code>.
			</p>
			<ol class="run-list">
				{
					stages.map((stage) => (
						<li>
							<span class="run-stage">{stage.name}</span>
							<code class="run-file" translate="no">
								{stage.file}
							</code>
						</li>
					))
				}
			</ol>
			<p class="band-foot">
				Rồi mới tới <code translate="no">/flow card</code>. Done thì phải có bằng chứng done: URL đã
				deploy, CLI cài được và chạy được, public API, hoặc một lần chạy skill thật.
			</p>
		</section>

		<section class="band stand" aria-labelledby="stand-title">
			<div class="stand-copy">
				<h2 class="stand-title" id="stand-title">flow gác cổng, chứ không viết code.</h2>
				<p>
					Agent vẫn viết. Được đi tiếp hay phải dừng thì cổng quyết.
				</p>
			</div>
			<div class="stand-actions">
				<a class="action primary" href={tutorial}>Cài và chạy lần đầu</a>
				<a class="action" href="/vi/docs/">Đọc tài liệu</a>
			</div>
		</section>
	</main>
</Landing>
